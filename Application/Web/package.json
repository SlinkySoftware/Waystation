{
  "name": "waystation-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "quasar prepare",
    "dev": "quasar dev",
    "dev:mock": "WAYSTATION_MOCK=1 quasar dev",
    "build": "quasar build && node scripts/bundle-budget.mjs",
    "build:mock": "WAYSTATION_MOCK=1 quasar build && node scripts/bundle-budget.mjs",
    "lint": "eslint . && vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-api": "node scripts/gen-api.mjs",
    "gen-api:check": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quasar/extras": "^2.1.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
