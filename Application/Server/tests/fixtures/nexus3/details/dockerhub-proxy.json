{
  "name": "dockerhub-proxy",
  "format": "docker",
  "type": "proxy",
  "url": "https://nexus.example.com/repository/dockerhub-proxy",
  "online": true,
  "storage": {
    "blobStoreName": "docker",
    "strictContentTypeValidation": true
  },
  "cleanup": {
    "policyNames": [
      "docker-unused-90d"
    ]
  },
  "proxy": {
    "remoteUrl": "https://registry-1.docker.io",
    "contentMaxAge": 1440,
    "metadataMaxAge": 1440
  },
  "negativeCache": {
    "enabled": true,
    "timeToLive": 1440
  },
  "httpClient": {
    "blocked": false,
    "autoBlock": true,
    "connection": {
      "retries": null,
      "userAgentSuffix": null,
      "timeout": null,
      "enableCircularRedirects": false,
      "enableCookies": false,
      "useTrustStore": false
    },
    "authentication": null
  },
  "routingRuleName": null,
  "docker": {
    "v1Enabled": false,
    "forceBasicAuth": false,
    "httpPort": null,
    "httpsPort": null,
    "subdomain": null
  },
  "dockerProxy": {
    "indexType": "HUB",
    "indexUrl": null,
    "cacheForeignLayers": false,
    "foreignLayerUrlWhitelist": []
  }
}
