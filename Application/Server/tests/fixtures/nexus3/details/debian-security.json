{
  "name": "debian-security",
  "format": "apt",
  "type": "proxy",
  "url": "https://nexus.example.com/repository/debian-security",
  "online": true,
  "storage": {
    "blobStoreName": "default",
    "strictContentTypeValidation": true
  },
  "cleanup": null,
  "proxy": {
    "remoteUrl": "http://security.debian.org/debian-security/",
    "contentMaxAge": -1,
    "metadataMaxAge": 60
  },
  "negativeCache": {
    "enabled": true,
    "timeToLive": 1440
  },
  "httpClient": {
    "blocked": false,
    "autoBlock": true,
    "connection": {
      "retries": null,
      "userAgentSuffix": null,
      "timeout": null,
      "enableCircularRedirects": false,
      "enableCookies": false,
      "useTrustStore": false
    },
    "authentication": null
  },
  "routingRuleName": null,
  "apt": {
    "distribution": "trixie-security",
    "flat": false
  }
}
