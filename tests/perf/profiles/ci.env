# CI profile (make perf): a few minutes, modest load, sized for a shared 12 vCPU / 32 GB box. tests/perf/README.md.
# Synthetic upstream content (origin/generate.py)
PERF_SMALL_FILES=64
PERF_MEDIUM_FILES=16
PERF_LARGE_MIB=256
PERF_MISS_SMALL=200
PERF_MISS_LARGE=3
PERF_MISS_LARGE_MIB=128
PERF_SLOW_FILES=3
PERF_SLOW_MIB=8
# Origin bandwidth for misses (nginx limit_rate; 100m = 100 MiB/s, about a 1 Gbit/s upstream; 0 = unlimited)
PERF_ORIGIN_RATE=100m
PERF_PACKAGES=40
PERF_VERSIONS=30
PERF_APT_STANZAS=5000
# Assets seeded for the API list/search scenario (the SPEC budget is stated at 1M: PROFILE=full)
PERF_BULK_ASSETS=100000
# Load
# Latency scenarios run at a fixed request rate (k6 constant-arrival-rate) with up to 4x VUS clients
PERF_HIT_RATE=200
PERF_HIT_VUS=10
PERF_HIT_DURATION_S=15
PERF_LARGE_ITERATIONS=3
PERF_API_RATE=50
PERF_API_VUS=10
PERF_API_DURATION_S=20
PERF_CONC_VUS=100
PERF_CONC_DURATION_S=20
# Container limits (CPUs, memory) and server processes
PERF_SERVER_CPUS=2
PERF_SERVER_WORKERS=2
PERF_SERVER_MEM=2g
PERF_WEB_CPUS=2
PERF_MONGO_CPUS=2
PERF_MONGO_MEM=1536m
PERF_MONGO_CACHE_GB=0.5
PERF_K6_CPUS=2
PERF_K6_MEM=2g
