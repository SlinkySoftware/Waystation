# Full profile (make perf PROFILE=full; nightly): the SPEC §5.1 sizes (1M assets, 500 concurrent downloads on a
# 4 vCPU server), about half an hour, several GB of disk. tests/perf/README.md.
# Synthetic upstream content (origin/generate.py)
PERF_SMALL_FILES=256
PERF_MEDIUM_FILES=64
PERF_LARGE_MIB=2048
PERF_MISS_SMALL=1000
PERF_MISS_LARGE=3
PERF_MISS_LARGE_MIB=1024
PERF_SLOW_FILES=10
PERF_SLOW_MIB=8
PERF_ORIGIN_RATE=100m
PERF_PACKAGES=200
PERF_VERSIONS=100
PERF_APT_STANZAS=50000
PERF_BULK_ASSETS=1000000
# Load
PERF_HIT_RATE=500
PERF_HIT_VUS=50
PERF_HIT_DURATION_S=60
PERF_LARGE_ITERATIONS=5
PERF_API_RATE=100
PERF_API_VUS=20
PERF_API_DURATION_S=60
PERF_CONC_VUS=500
PERF_CONC_DURATION_S=60
# Container limits: the server gets 4 vCPUs (SPEC: 500 concurrent downloads on 4 vCPU)
PERF_SERVER_CPUS=4
PERF_SERVER_WORKERS=4
PERF_SERVER_MEM=4g
PERF_WEB_CPUS=2
PERF_MONGO_CPUS=4
PERF_MONGO_MEM=4g
PERF_MONGO_CACHE_GB=2
PERF_K6_CPUS=4
PERF_K6_MEM=4g
