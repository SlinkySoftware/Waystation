# Alpine apk (T-P6-APK): apk update + apk add through a proxy of the Alpine CDN (APKINDEX passed through and verified by
# apk with the image's Alpine keys; the package verified by Waystation against the index C: checksum), then a package
# assembled in the client is uploaded to a hosted repository with curl, the worker publishes a signed APKINDEX, apk
# refuses it until the repository's key is in /etc/apk/keys, then installs, upgrades and loses a deleted version
# (tests/clients/README.md; Documents/Operations/clients/apk.md).

HOSTS="dl-cdn.alpinelinux.org"
# Alpine 3.22 with curl added at image build (compose.harness.yaml client-alpine).
CLIENT=alpine
NEEDS_STACK=1
# v3.22 main x86_64 only: its APKINDEX.tar.gz (about 500 KB, signed by Alpine: recorded whole, so the signature stays
# valid; no trimming) and one tiny package (tree). Budget 1.5 MiB.
FIXTURE_BUDGET_KB=1536
FIXTURE_FILE_MAX_KB=1024
