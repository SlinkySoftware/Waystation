# Helm classic repositories (T-P5-HELM): helm 3 repo add/update/search/pull/template through a Waystation Helm proxy
# of the metrics-server chart repository (a small index; the charts live on GitHub releases, so absolute chart URLs
# and the release-asset redirect are exercised), a hosted repository (curl upload, ChartMuseum API) and a group.
# tests/clients/README.md; Documents/Operations/clients/helm.md.

# Upstream host names the fake upstream impersonates: the index, the release download and its redirect target.
HOSTS="kubernetes-sigs.github.io github.com release-assets.githubusercontent.com"
# alpine/helm: helm 3 and helm 4 (both with curl), one after the other against one stack.
CLIENT="helm helm4"
NEEDS_STACK=1
# One index (about 25 KB) and one chart package (about 14 KB).
FIXTURE_BUDGET_KB=256
