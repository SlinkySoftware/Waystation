# Cargo (T-P6-CARGO): cargo (official Rust image) builds a tiny program with two small crates.io dependencies through
# a sparse proxy of index.crates.io (source replacement), publishes a crate to a hosted registry with an API token and
# builds against it, yanks and un-yanks it, then resolves both through a group that needs credentials
# (tests/clients/README.md; Documents/Operations/clients/cargo.md).

# The sparse index and the download host its config.json names (the server fetches both; cargo reaches neither).
HOSTS="index.crates.io static.crates.io"
# rust:1.99.1-slim-trixie with curl (compose.harness.yaml client-cargo).
CLIENT=cargo
NEEDS_STACK=1
# cfg-if 1.0.0 and itoa 1.0.11: config.json, two index files and two .crate files (about 60 KB).
FIXTURE_BUDGET_KB=512
FIXTURE_FILE_MAX_KB=256
