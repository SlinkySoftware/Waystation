# apt proxy (T-P2-APT): apt-get update + install on Debian 13 and Ubuntu 26.04 through four Waystation apt proxies
# (debian, debian-security, ubuntu, ubuntu-security). tests/clients/README.md; Documents/Operations/clients/apt.md.
#
# Fixtures are recorded against small real suites only (owner decision 2026-11-08): trixie-updates,
# trixie-security, resolute-updates and resolute-security, component main, amd64, compressed Packages files only
# (no translations, contents or dep11). Full suites (trixie, resolute) are covered by the nightly live run.

# Upstream host names the fake upstream impersonates (Debian security is served from deb.debian.org/debian-security).
HOSTS="deb.debian.org archive.ubuntu.com security.ubuntu.com"
# Both client images, one after the other against one stack (HARNESS_CLIENT tells the scripts which one runs).
CLIENT="debian ubuntu"
NEEDS_STACK=1
# InRelease + Packages.xz of four small suites and three tiny .debs (about 2.5 MiB today). Raised from the 8 MiB
# default to 32 MiB for apt: security/updates indexes grow over a release's life.
FIXTURE_BUDGET_KB=32768
