# Client-auth matrix (T-A04): every Phase 2 client against private repositories with credentials from an LDAP
# directory (OpenLDAP) and an OpenID provider (Keycloak), the same test-only directory and realm as
# `make test-integration` (Build/Containers/test/). Positive and negative cases per client: docker login with an LDAP
# password and with an OIDC user's API token, npm login (LDAP password) and _authToken, apt auth.conf, dnf basic auth,
# raw (curl) basic auth; wrong password, revoked token, account password where only tokens are accepted, a signed-in
# user without a role, anonymous refused. tests/clients/README.md "auth"; Documents/Operations/clients/auth.md.
#
# Only the apt row reaches an upstream (an apt proxy cannot be hosted): the small trixie-updates suite.
HOSTS="deb.debian.org"
# curl first: it configures Waystation (providers, role, repositories, anonymous access off) and signs the OIDC user
# in through Keycloak's login form, leaving one API token per client in /harness-shared. Then each client in turn.
CLIENT="curl docker node debian rocky"
NEEDS_STACK=1
# OpenLDAP (with its throwaway CA from ldap-certs) and Keycloak, on the stack's frontend network (profile idp).
SERVICES="openldap keycloak"
# Dozens of password sign-ins (docker login sends the password with every token request) and refused tokens come from
# a handful of addresses within minutes: raise the per-address limits (SPECIFICATION §4.9) for this run only.
STACK_ENV="WAYSTATION_LOGIN_RATE_LIMIT=1000 WAYSTATION_TOKEN_FAILURE_LIMIT=1000"
# InRelease + Packages.xz of trixie-updates (about 50 KB).
FIXTURE_BUDGET_KB=512
