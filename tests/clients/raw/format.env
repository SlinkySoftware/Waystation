# Raw (generic files) proxy: curl and wget fetch small, stable files from the Debian archive's top level through a
# raw proxy repository (tests/clients/README.md; Documents/Operations/clients/raw.md).

# Upstream host names the fake upstream impersonates.
HOSTS="deb.debian.org"
# curl image (Alpine: curl plus BusyBox wget).
CLIENT=curl
# The Waystation stack serves the files.
NEEDS_STACK=1
# A few small text files.
FIXTURE_BUDGET_KB=64
