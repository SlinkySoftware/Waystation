# yum proxy (T-P2-YUM): dnf makecache + install + reinstall on Rocky Linux 10 and AlmaLinux 10 through two Waystation
# yum proxies (rocky, almalinux). tests/clients/README.md; Documents/Operations/clients/yum.md.
#
# Fixtures are recorded against the small `extras` repositories only (a few dozen packages, repodata of a few KiB,
# tiny release packages). BaseOS/AppStream, EPEL and Oracle Linux are left to the nightly live run.

# Upstream host names the fake upstream impersonates.
HOSTS="dl.rockylinux.org repo.almalinux.org"
# Both client images, one after the other against one stack (HARNESS_CLIENT tells the scripts which one runs).
CLIENT="rocky alma"
NEEDS_STACK=1
