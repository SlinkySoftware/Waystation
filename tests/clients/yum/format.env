# yum proxy (T-P2-YUM): dnf makecache + install + reinstall through Waystation yum proxies on Rocky Linux 10 (rocky
# extras with repomd.xml verified by Waystation, then EPEL 10), AlmaLinux 10 (almalinux extras) and Oracle Linux 9
# (oracle addons), plus dnf 5 (Fedora) and zypper (openSUSE Leap) smoke runs against the cached Rocky extras.
# tests/clients/README.md; Documents/Operations/clients/yum.md.
#
# Fixtures are recorded against small repositories only: Rocky/AlmaLinux `extras` (a few dozen packages), Oracle
# Linux 9 `addons` (a few hundred KB of repodata) and EPEL 10 `Everything` (dnf fetches primary, updateinfo and comps:
# about 8 MB, the bulk of the fixtures), each with one tiny package. BaseOS/AppStream are left to the nightly live run.

# Upstream host names the fake upstream impersonates.
HOSTS="dl.rockylinux.org repo.almalinux.org yum.oracle.com dl.fedoraproject.org"
# The client images, one after the other against one stack (HARNESS_CLIENT tells the scripts which one runs).
CLIENT="rocky alma oracle fedora opensuse"
NEEDS_STACK=1
# Raised from 8 MiB / 4 MiB (2026-11-10): EPEL's primary.xml.zst alone is about 4.5 MB and grows over a release.
FIXTURE_BUDGET_KB=16384
FIXTURE_FILE_MAX_KB=8192
