# PyPI (T-P5-PYPI): pip and uv install through a proxy of pypi.org, twine and uv publish upload to a hosted
# repository, and pip/uv install through a group of both (tests/clients/README.md; Documents/Operations/clients/pypi.md).

# The simple index and the file host (wheels, sdists and PEP 658 .metadata files).
HOSTS="pypi.org files.pythonhosted.org"
# python:3.14-slim with pip, uv and twine.
CLIENT=python
NEEDS_STACK=1
# Two tiny pure-Python projects (six, iniconfig): their simple pages, wheels and .metadata files.
FIXTURE_BUDGET_KB=512
