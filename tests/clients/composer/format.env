# Composer 2 (T-P6-COMPOSER): the composer CLI installs a tiny public package through a proxy of repo.packagist.org
# (its archive fetched by Waystation from GitHub's archive host, verified and pinned), uploads a generated package to
# a hosted repository with an API token, installs it through the hosted repository and through a group of both
# (tests/clients/README.md; Documents/Operations/clients/composer.md).

# Packagist's packages.json and p2 metadata; the archive host GitHub's API zipball URLs redirect to (Waystation
# fetches codeload.github.com directly, so api.github.com is never asked).
HOSTS="repo.packagist.org codeload.github.com"
# The official composer image (compose.harness.yaml client-composer).
CLIENT=composer
NEEDS_STACK=1
# psr/container 2.0.2 (no dependencies): packages.json, its p2 document (about 10 KB) and the archive (about 7 KB),
# plus the 404s for the hosted package's name that the group's proxy member asks about. Budget 256 KiB.
# Packagist's normalised versions (four numbers) read as IP addresses to the forbidden-strings check: they are dropped from
# recorded bodies, and Waystation normalises the published version itself when the key is missing.
DROP_JSON_KEYS="version_normalized"
FIXTURE_BUDGET_KB=256
FIXTURE_FILE_MAX_KB=128
