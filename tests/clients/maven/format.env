# Maven (T-P5-MAVEN): mvn 3.9 resolves through a Maven Central proxy and a group, and deploys releases and SNAPSHOTs
# to hosted repositories. tests/clients/README.md; Documents/Operations/clients/maven.md.
#
# The client image carries the build plugins (dependency, compiler, jar, install, deploy...) pre-seeded from Maven
# Central at image build time, so the fixtures hold only what the tests resolve through Waystation: junit 4.13.2 with
# hamcrest-core (and its parent POM) and reactive-streams through a version range (maven-metadata.xml), < 1 MiB.

# Upstream host names the fake upstream impersonates.
HOSTS="repo.maven.apache.org"
CLIENT=maven
NEEDS_STACK=1
FIXTURE_BUDGET_KB=1024
