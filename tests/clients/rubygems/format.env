# RubyGems (T-P6-GEMS): gem and Bundler install a tiny public gem through a proxy of rubygems.org (the .gem verified
# against the compact index checksum), gem push builds and publishes a generated gem to a hosted repository with an
# API token, gem installs it from there (Waystation's own Marshal gemspec), Bundler installs both through a group
# configured as the rubygems.org mirror, and gem yank removes a version (tests/clients/README.md;
# Documents/Operations/clients/rubygems.md).

# rubygems.org serves the compact index, gemspecs and gems; Bundler and gem also know index.rubygems.org.
HOSTS="rubygems.org index.rubygems.org"
# The official ruby image (compose.harness.yaml client-ruby): ruby, gem, Bundler, bash (no curl).
CLIENT=ruby
NEEDS_STACK=1
# rubygems.org's versions file (tens of MB) and names list are reduced to the gem the test uses when recorded (the
# version lines keep their info MD5, so they stay consistent with the recorded info file).
KEEP_LINES='/versions=(created_at:.*|---|hola\x20.*) /names=(---|hola)'
# hola 0.1.3 (no dependencies): versions and names (reduced), its info file, gemspec and .gem (about 5 KB), plus the
# 404 for the hosted gem's name that the group's proxy member asks about. Budget 256 KiB.
FIXTURE_BUDGET_KB=256
FIXTURE_FILE_MAX_KB=128
