# Conda (T-P6-CONDA): micromamba creates an environment with one tiny noarch package (tzdata) through a proxy of the
# conda-forge channel, then uploads two packages it builds (.conda and .tar.bz2) to a hosted channel and installs them
# with an API token (tests/clients/README.md; Documents/Operations/clients/conda.md).

# The channel host (the server fetches repodata and packages from it; micromamba reaches only Waystation).
HOSTS="conda.anaconda.org"
# mambaorg/micromamba:2.3.3 with curl, zip, zstd, bzip2 (compose.harness.yaml client-micromamba).
CLIENT=micromamba
NEEDS_STACK=1
# tzdata's .conda file and the noarch / linux-64 repodata, trimmed after recording to the entries the test uses.
FIXTURE_BUDGET_KB=512
FIXTURE_FILE_MAX_KB=256
