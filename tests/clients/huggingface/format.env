# Hugging Face (T-P6-HF): huggingface_hub 2.4 (Python API and the hf CLI, hf_xet installed) downloads files of a tiny
# public model through a proxy of the Hub: hf_hub_download, hf download and snapshot_download, then again from
# Waystation's cache with the repository offline (tests/clients/README.md; Documents/Operations/clients/huggingface.md).

# The Hub and the CDN hosts it redirects LFS/Xet file downloads to (the server fetches from them; the client reaches
# only Waystation).
HOSTS="huggingface.co us.aws.cdn.hf.co cdn-lfs.hf.co cdn-lfs-us-1.hf.co cas-bridge.xethub.hf.co"
# python:3.14-slim with huggingface_hub 2.4.0 and curl (compose.harness.yaml client-huggingface).
CLIENT=huggingface
NEEDS_STACK=1
# julien-c/dummy-unknown without its TF and Flax weights: info and tree documents, five small files and one LFS file
# (pytorch_model.bin, 64 KiB).
FIXTURE_BUDGET_KB=256
FIXTURE_FILE_MAX_KB=128
