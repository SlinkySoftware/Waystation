# Harness self-test format (tests/clients/README.md). Proves the record/replay/fake-upstream/client-container
# plumbing end to end without a Waystation format: curl talks to the fake upstream directly.

# Upstream host names the fake upstream impersonates (TLS SANs + extra_hosts in every container).
HOSTS="echo.example.com"
# Client container (compose service client-<CLIENT> in compose.harness.yaml).
CLIENT=curl
# 1 = start the Waystation stack (web, server, worker, mongodb, valkey) before the client runs.
NEEDS_STACK=0
# Record/live only: where the fake upstream really connects instead of the public host (host=scheme://addr:port).
ORIGINS="echo.example.com=http://echo-origin:8080"
# Record/live only: extra harness services to start (the echo format's "live upstream").
RECORD_SERVICES="echo-origin"
# Fixture size budget for this format (check_fixtures.py).
FIXTURE_BUDGET_KB=64
