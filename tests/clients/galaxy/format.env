# Ansible Galaxy (T-P5-GALAXY): ansible-galaxy installs a small collection through a proxy of galaxy.ansible.com
# (Galaxy NG paths, download_url rewritten, artifact verified by sha256), publishes a locally built collection to a
# hosted repository (import task polled until completed) and installs both through a group; a role through the
# legacy v1 roles API (archive from GitHub cached). tests/clients/README.md; Documents/Operations/clients/galaxy.md.

# The Galaxy API (its artifact URLs redirect twice: to Pulp content, then to the S3 bucket), and the GitHub tag
# archive of the role (with its codeload redirect).
HOSTS="galaxy.ansible.com ansible-galaxy-ng.s3.dualstack.us-east-1.amazonaws.com github.com codeload.github.com"
# python:3.14-slim with ansible-core 2.22 and curl.
CLIENT=ansible
NEEDS_STACK=1
# One collection (community.library_inventory_filtering_v1 1.1.5, about 36 KB) with its documents, one role archive
# (geerlingguy.ntp 4.0.1) with the role search and version list.
FIXTURE_BUDGET_KB=512
# Galaxy version documents carry the whole file list and docs: Waystation drops them, so they need not be kept.
DROP_JSON_KEYS="files docs_blob"
