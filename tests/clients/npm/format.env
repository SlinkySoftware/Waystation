# npm proxy (T-P2-NPM): npm install through Waystation against a recorded registry.npmjs.org.
HOSTS="registry.npmjs.org"
CLIENT=node
NEEDS_STACK=1
# Packument fields npm install does not need that carry personal data (maintainer e-mails), registry-internal host
# names and README links: removed from the recorded packuments (Waystation does not verify packument bytes).
DROP_JSON_KEYS="readme readmeFilename maintainers _npmUser author contributors users _npmOperationalInternal homepage bugs repository"
# Abbreviated + full packuments and a handful of tiny tarballs: well under the 8 MiB default.
FIXTURE_BUDGET_KB=1024
