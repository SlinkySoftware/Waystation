# Docker / OCI proxy: the docker daemon pulls through Waystation in mirror mode (registry-mirrors), by repository
# prefix and by upstream alias; skopeo inspects, lists tags and copies (tests/clients/README.md;
# Documents/Operations/clients/docker.md). Tiny images only, pinned to linux/amd64 so replay works on any host.

# Docker Hub (registry, token service, both blob CDNs) and GHCR (registry, blob CDN).
HOSTS="registry-1.docker.io auth.docker.io production.cloudflare.docker.com production.cloudfront.docker.com ghcr.io pkg-containers.githubusercontent.com"
# docker:dind with curl and skopeo added (compose.harness.yaml); setup.sh starts dockerd.
CLIENT=docker
NEEDS_STACK=1
# hello-world (Docker Hub, a few KB) and busybox (GHCR, ~2 MB layer).
FIXTURE_BUDGET_KB=4096
