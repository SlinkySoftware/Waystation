    <name xml:lang="ja">カスタムオペレーティングシステム</name>
    <name xml:lang="ko">사용자 정의 운영 체제</name>
    <name xml:lang="zh_CN">定制操作系统</name>
    <description>Basic building block for a custom AlmaLinux system.</description>
