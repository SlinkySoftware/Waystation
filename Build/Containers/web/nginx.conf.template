# Waystation site config (rendered by the nginx image's envsubst step; only ${WAYSTATION_*} variables are
# substituted, nginx's own $variables are left alone).
#   WAYSTATION_DATA_DIR     blob store mount, read-only here (default /var/lib/waystation)
# The listeners (plain HTTP, or TLS + HTTP/2 with a plain-HTTP redirect), the server list and the docker dedicated
# port connectors are rendered by /docker-entrypoint.d/15-waystation.sh into the included *.inc files and
# waystation-connectors.conf (WAYSTATION_SERVER_ADDR, WAYSTATION_WEB_PORT, WAYSTATION_TLS_CERT/KEY,
# WAYSTATION_DOCKER_CONNECTORS).

upstream waystation_server {
    include /tmp/nginx-conf/waystation-upstream.inc;
    keepalive 64;
}

server {
    include /tmp/nginx-conf/waystation-listen.inc;
    server_name _;

    # Proxy settings shared with the docker connector listeners (waystation-proxy.inc.template). A client never
    # chooses the connector header: only connector listeners (15-waystation.sh) set it (ADR 0013).
    include /tmp/nginx-conf/waystation-proxy.inc;
    proxy_set_header X-Waystation-Connector "";
    # Security headers (rendered by 15-waystation.sh): locations with their own add_header include them again.
    include /tmp/nginx-conf/waystation-headers.inc;

    # ---- container healthcheck (answered by nginx itself)
    location = /_web/healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- SPA (UI_DESIGN; hashed assets are immutable, index.html never cached)
    location = / {
        return 302 /ui/;
    }
    location = /ui {
        return 302 /ui/;
    }
    location /ui/assets/ {
        alias /usr/share/nginx/html/ui/assets/;
        include /tmp/nginx-conf/waystation-ui-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /ui/ {
        alias /usr/share/nginx/html/ui/;
        include /tmp/nginx-conf/waystation-ui-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /ui/index.html;
    }

    # ---- dynamic paths -> server (ARCHITECTURE §1)
    location /api/ {
        proxy_pass http://waystation_server;
    }
    location /v2/ {
        proxy_pass http://waystation_server;
    }
    location = /v2 {
        proxy_pass http://waystation_server;
    }
    location /repository/ {
        proxy_pass http://waystation_server;
    }
    location /auth/ {
        proxy_pass http://waystation_server;
    }
    location /.well-known/ {
        proxy_pass http://waystation_server;
    }
    location = /healthz {
        proxy_pass http://waystation_server;
    }
    location = /readyz {
        proxy_pass http://waystation_server;
    }
    location = /metrics {
        proxy_pass http://waystation_server;
    }

    # ---- live event stream (ARCHITECTURE §8): long-lived, never buffered
    location = /api/v1/events/stream {
        proxy_pass http://waystation_server;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        include /tmp/nginx-conf/waystation-headers.inc;
        add_header X-Accel-Buffering no always;
    }

    # ---- cached content via X-Accel-Redirect (waystation-blobs.inc.template)
    include /tmp/nginx-conf/waystation-blobs.inc;

    location / {
        return 404;
    }
}
