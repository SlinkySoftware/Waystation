# Waystation site config (rendered by the nginx image's envsubst step; only ${WAYSTATION_*} variables are
# substituted, nginx's own $variables are left alone).
#   WAYSTATION_SERVER_ADDR  host:port of the server service (default waystation-server:8000)
#   WAYSTATION_DATA_DIR     blob store mount, read-only here (default /var/lib/waystation)
#   WAYSTATION_WEB_PORT     listen port inside the container (default 8080)

upstream waystation_server {
    server ${WAYSTATION_SERVER_ADDR};
    keepalive 64;
}

server {
    listen ${WAYSTATION_WEB_PORT};
    server_name _;

    # Large artifacts pass through untouched (SPECIFICATION §8.4): no body size limit, no buffering.
    client_max_body_size 0;
    absolute_redirect off;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-Id $request_id;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 10s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    # The server answers with X-Accel-Redirect for cached content; let nginx follow it.
    proxy_intercept_errors off;

    # ---- SPA (UI_DESIGN; hashed assets are immutable, index.html never cached)
    location = / {
        return 302 /ui/;
    }
    location = /ui {
        return 302 /ui/;
    }
    location /ui/assets/ {
        alias /usr/share/nginx/html/ui/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /ui/ {
        alias /usr/share/nginx/html/ui/;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /ui/index.html;
    }

    # ---- dynamic paths -> server (ARCHITECTURE §1)
    location /api/ {
        proxy_pass http://waystation_server;
    }
    location /v2/ {
        proxy_pass http://waystation_server;
    }
    location = /v2 {
        proxy_pass http://waystation_server;
    }
    location /repository/ {
        proxy_pass http://waystation_server;
    }
    location /auth/ {
        proxy_pass http://waystation_server;
    }
    location /.well-known/ {
        proxy_pass http://waystation_server;
    }
    location = /healthz {
        proxy_pass http://waystation_server;
    }
    location = /readyz {
        proxy_pass http://waystation_server;
    }
    location = /metrics {
        proxy_pass http://waystation_server;
    }

    # ---- live event stream (ARCHITECTURE §8): long-lived, never buffered
    location = /api/v1/events/stream {
        proxy_pass http://waystation_server;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no always;
    }

    # ---- cached content via X-Accel-Redirect (ARCHITECTURE §4.5). Only reachable by an internal redirect from
    # the server. The server answers conditional requests itself; nginx serves bytes and ranges.
    location /_blobs/ {
        internal;
        alias ${WAYSTATION_DATA_DIR}/blobs/;
        sendfile on;
        etag off;
        # Content-Type is taken from the server's response on the internal redirect; nginx copies it. The empty
        # types map keeps nginx from guessing a type from the (extension-less) blob file name.
        types { }
        default_type application/octet-stream;
        add_header ETag $upstream_http_x_ws_etag always;
        add_header Docker-Content-Digest $upstream_http_docker_content_digest always;
        add_header Docker-Distribution-API-Version $upstream_http_docker_distribution_api_version always;
        add_header X-Ws-Digest $upstream_http_x_ws_digest always;
        add_header X-Ws-Cache $upstream_http_x_ws_cache always;
        add_header X-Request-Id $upstream_http_x_request_id always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        return 404;
    }
}
