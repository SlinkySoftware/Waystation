# Waystation web tier: proxy settings to the server
# (rendered by the nginx image's envsubst step into /tmp/nginx-conf; included by the main server and by every docker
# dedicated port connector server, see 15-waystation.sh).
# Large artifacts pass through untouched (SPECIFICATION §8.4): no body size limit, no buffering.
client_max_body_size 0;
absolute_redirect off;

proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Request-Id $request_id;
proxy_request_buffering off;
proxy_buffering off;
proxy_connect_timeout 10s;
proxy_send_timeout 600s;
proxy_read_timeout 600s;
# The server answers with X-Accel-Redirect for cached content; let nginx follow it.
proxy_intercept_errors off;
