{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "uid": "waystation-overview",
  "title": "Waystation",
  "description": "Waystation artifact repository: requests, cache efficiency and upstreams from /metrics.",
  "tags": [
    "waystation"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(waystation_requests_total, job)",
        "query": {
          "query": "label_values(waystation_requests_total, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(waystation_requests_total{job=~\"$job\"}, instance)",
        "query": {
          "query": "label_values(waystation_requests_total{job=~\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(waystation_requests_total{job=~\"$job\",instance=~\"$instance\"}, repo)",
        "query": {
          "query": "label_values(waystation_requests_total{job=~\"$job\",instance=~\"$instance\"}, repo)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "description": "Format requests per second answered by the proxy engine (selected repositories).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of requests in the time range answered from the blob store (HIT, REVALIDATED, STALE) out of all requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",cache=~\"HIT|REVALIDATED|STALE\"}[$__range])) / sum(increase(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Served from cache",
      "description": "Bytes sent to clients from the blob store in the time range: upstream bandwidth saved.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(waystation_bytes_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",direction=\"out_cache\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fetched from upstream",
      "description": "Bytes downloaded from upstream registries in the time range (cache fills and pass-through).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(waystation_bytes_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",direction=\"in_upstream\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Upstream error ratio",
      "description": "Share of requests in the time range that failed because the upstream could not be reached or answered wrongly (cache state ERROR, HTTP 502).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",cache=\"ERROR\"}[$__range])) / sum(increase(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Transfers in flight",
      "description": "Live transfers right now, summed over the scraped server processes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(waystation_inflight_transfers{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests by cache state",
      "description": "HIT: from cache. REVALIDATED: metadata checked upstream, unchanged. STALE: from cache because the upstream failed. FETCHING: miss, this request fetched it. COALESCED: miss, joined another request's fetch. ERROR: failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cache) (rate(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "{{cache}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput",
      "description": "out_cache: to clients from the blob store. out_upstream: to clients while streaming from upstream. in_upstream: downloaded from upstreams.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (direction) (rate(waystation_bytes_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "{{direction}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit ratio by repository",
      "description": "Requests answered from the blob store / all requests, per repository.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (repo) (rate(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",cache=~\"HIT|REVALIDATED|STALE\"}[$__rate_interval])) / sum by (repo) (rate(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "{{repo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream errors by repository",
      "description": "Requests per second that failed because of the upstream (cache state ERROR). A sustained rate means the repository's upstream is degraded or down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (repo) (rate(waystation_requests_total{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\",cache=\"ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{repo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Upstream latency (p95)",
      "description": "Time from the upstream request to its response headers, 95th percentile per repository.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, repo) (rate(waystation_upstream_latency_seconds_bucket{job=~\"$job\",instance=~\"$instance\",repo=~\"$repo\"}[$__rate_interval])))",
          "legendFormat": "{{repo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Request coalescing",
      "description": "owner: fetched for others. tail: followed a fetch by streaming its file. wait: waited for the commit. solo: fetched without Valkey coordination. takeover: took over from an owner that went away.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
