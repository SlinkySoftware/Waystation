# Waystation environment (example). Copy to an env file outside the repo and fill in.
# GENERATED from waystation_common.settings by `make env-example`; do not edit by hand.
# Every secret (marked [secret]) can instead be read from a file: set <NAME>_FILE to its path.
# Never put real hostnames or secrets in this file.

# Public base URL clients use (scheme, host, optional port; no trailing slash).
WAYSTATION_BASE_URL=https://registry.example.com

# Name shown in the UI top bar and on the sign-in page.
WAYSTATION_INSTANCE_NAME=Waystation

# Log level: DEBUG, INFO, WARNING, ERROR.
WAYSTATION_LOG_LEVEL=INFO

# Log format: json (default) or console.
WAYSTATION_LOG_FORMAT=json

# Blob store root (blobs/, uploads/, keys/). Same path in every container.
WAYSTATION_DATA_DIR=/var/lib/waystation

# UID owning the data dir (server and worker run as this user).
WAYSTATION_UID=10001

# Shared GID for server, worker and web (ARCHITECTURE §4.5).
WAYSTATION_GID=10001

# Largest single upload or cached file, in GiB.
WAYSTATION_MAX_UPLOAD_GB=64.0

# Refuse new cache/upload writes below this much free space, in GiB.
WAYSTATION_MIN_FREE_GB=5.0

# Coalescing followers: auto, local (always tail) or wait (ARCHITECTURE §6.3).
WAYSTATION_COALESCE_TAIL=auto

# Coalescing lease, in seconds: a fill whose owner stops renewing it is taken over after this long.
WAYSTATION_COALESCE_LEASE_S=15.0

# MongoDB connection URI. [secret]
WAYSTATION_MONGO_URI=mongodb://waystation-mongodb:27017/?replicaSet=rs0

# MongoDB database name.
WAYSTATION_MONGO_DB=waystation

# init: initiate the single-node replica set named in MONGO_URI if needed (bundled MongoDB).
WAYSTATION_MONGO_REPLSET_INIT=false

# Valkey connection URL. [secret]
WAYSTATION_VALKEY_URL=redis://waystation-valkey:6379/0

# Comma-separated base64 AES-256 keys; the first encrypts, all decrypt. Generate with: head -c 32 /dev/urandom | base64 [secret]
WAYSTATION_SECRET_KEYS=

# Session signing secret. [secret]
WAYSTATION_SESSION_SECRET=

# First admin password (prefer the _FILE form); unset = a one-time password is printed by init. [secret]
WAYSTATION_BOOTSTRAP_ADMIN_PASSWORD=

# Sign out a UI session after this long without use.
WAYSTATION_SESSION_IDLE_MINUTES=480

# Absolute lifetime of a UI session, in hours.
WAYSTATION_SESSION_MAX_HOURS=168

# Sign-in attempts allowed per client address per 5 minutes (then 429).
WAYSTATION_LOGIN_RATE_LIMIT=20

# Consecutive failed sign-ins that lock a local account.
WAYSTATION_LOGIN_LOCKOUT_FAILURES=10

# How long a locked local account stays locked.
WAYSTATION_LOGIN_LOCKOUT_MINUTES=15

# Rejected API tokens allowed per client address per 5 minutes (then 429).
WAYSTATION_TOKEN_FAILURE_LIMIT=60

# Days an audit record is kept (applies to records written from then on).
WAYSTATION_AUDIT_RETENTION_DAYS=400

# Trust X-Forwarded-* from TRUSTED_PROXIES.
WAYSTATION_TRUST_FORWARDED=false

# Comma-separated CIDRs of trusted reverse proxies.
WAYSTATION_TRUSTED_PROXIES=

# Comma-separated CIDRs allowed to scrape /metrics without a token.
WAYSTATION_METRICS_ALLOW_CIDRS=127.0.0.0/8,::1/128

# Private CIDRs upstreams may resolve to (SSRF guard exceptions).
WAYSTATION_SSRF_ALLOW_CIDRS=

# Outbound HTTP proxy for upstream fetches.
WAYSTATION_HTTP_PROXY=

# Hosts that bypass HTTP_PROXY.
WAYSTATION_NO_PROXY=

# Extra CA bundle (PEM) trusted for upstream TLS.
WAYSTATION_EXTRA_CA_FILE=

# Server processes per container.
WAYSTATION_SERVER_WORKERS=1

# Comma-separated job queues this worker consumes.
WAYSTATION_WORKER_QUEUES=index,maintenance,stats,prefetch,import

# Concurrent jobs per worker.
WAYSTATION_WORKER_CONCURRENCY=4
