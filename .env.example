# Waystation environment (example). Copy to .env outside the repo and fill in.
# This file is generated from waystation_common.settings by `make env-example` (task T-F04).
# Until then it is a hand-written stub. Never put real hostnames or secrets in this file.

WAYSTATION_BASE_URL=https://registry.example.com
WAYSTATION_DATA_DIR=/var/lib/waystation
WAYSTATION_MONGO_URI=mongodb://waystation-mongodb:27017/?replicaSet=rs0
WAYSTATION_MONGO_DB=waystation
WAYSTATION_VALKEY_URL=redis://waystation-valkey:6379/0
# Comma-separated, first key encrypts. Generate with: head -c 32 /dev/urandom | base64
WAYSTATION_SECRET_KEYS=
WAYSTATION_SESSION_SECRET=
WAYSTATION_LOG_LEVEL=INFO
